# Telegram API credentials (https://my.telegram.org)
API_ID=0
API_HASH=
BOT_TOKEN=

# Bot admin Telegram user ID
ADMIN_ID=0

# MongoDB connection string (all bot configs & WZGram sessions are stored in MongoDB)
MONGO_URI=mongodb://mongo:27017
DB_NAME=MediaInfo-Bot
USE_MONGO_SESSION=true

# Optional bootstrap defaults (seeded into MongoDB on first run and editable via /panel)
ALLOWED_CHATS=
LOG_LEVEL=INFO
PORT=8080

# Caption layout. Placeholders:
#   {title} {video_line} {duration} {audio} {subtitle}
#   {size} {bitrate} {fps} {resolution} {codec} {container} {filename}
# CAPTION_TEMPLATE=

# --- Probing & queue defaults (persisted & editable in MongoDB via /panel) ---
PROBE_TIMEOUT=15
STREAM_TIMEOUT=90
STREAM_RETRIES=3
STREAM_CONCURRENCY=2
CHANNEL_CONCURRENCY=2
ENABLE_TAIL_PROBE=true
TAIL_SIZE_MB=1
TMP_DIR=downloads
SESSION_DIR=.
EDIT_DELAY=3.5
FULL_REPORT=true
ERROR_THRESHOLD=3
ALERT_COOLDOWN=600
MAX_RETRY_ATTEMPTS=5
GC_GEN0=700
GC_GEN1=10
GC_GEN2=10
