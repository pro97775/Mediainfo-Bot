# Telegram API credentials (https://my.telegram.org)
API_ID=0
API_HASH=
BOT_TOKEN=

# Bot admin Telegram user ID
ADMIN_ID=0

# Space or comma separated channel/chat IDs the bot may process
ALLOWED_CHATS=

# MongoDB connection string (defaults to the compose service)
MONGO_URI=mongodb://mongo:27017

# Optional
LOG_LEVEL=INFO
PORT=8080

# Caption layout. Placeholders:
#   {title} {video_line} {duration} {audio} {subtitle}
#   {size} {bitrate} {fps} {resolution} {codec} {container} {filename}
# CAPTION_TEMPLATE=

# --- Probing behaviour ---
# Seconds allowed for each mediainfo / ffprobe run
PROBE_TIMEOUT=15
# Seconds allowed for one streaming step
STREAM_TIMEOUT=90
# Retries per streaming step when a datacenter misbehaves
STREAM_RETRIES=3
# Parallel media streams (higher = faster when files live on several DCs)
STREAM_CONCURRENCY=2
# Channels processed in parallel
CHANNEL_CONCURRENCY=2
# Also read the end of the file when the header lacks metadata
ENABLE_TAIL_PROBE=true
# Where temporary probe chunks are written
TMP_DIR=downloads
# Where the pyrogram session file is stored (put it on a persistent volume)
SESSION_DIR=.
# Seconds between caption edits in the same channel
EDIT_DELAY=3.5
# Attach a "Full MediaInfo" button to /info replies
FULL_REPORT=true

